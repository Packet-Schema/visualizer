{
  "name": "packet-schema-visualizer-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/build-presets.ts && tsx scripts/generate-og-font.ts",
    "dev": "next dev",
    "build:presets": "tsx scripts/build-presets.ts",
    "generate:og-font": "tsx scripts/generate-og-font.ts",
    "prebuild": "tsx scripts/build-presets.ts && tsx scripts/generate-og-font.ts",
    "build": "opennextjs-cloudflare build",
    "prebuild:next": "tsx scripts/generate-og-font.ts",
    "build:next": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prelint": "tsx scripts/build-presets.ts",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "tsx scripts/build-presets.ts && tsx scripts/generate-og-font.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/build-presets.ts && tsx scripts/generate-og-font.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "tsx scripts/build-presets.ts && tsx scripts/generate-og-font.ts",
    "test:coverage": "vitest run --coverage",
    "test:format": "vitest run tests/formats",
    "pretest:diag": "tsx scripts/build-presets.ts && tsx scripts/generate-og-font.ts",
    "test:diag": "vitest run --config vitest.diag.config.ts",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "preview:start": "opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.10",
    "@fontsource/line-seed-jp": "^5.3.1",
    "@packet-schema/core": "^0.1.0",
    "@packet-schema/presets": "^0.1.0",
    "lz-string": "^1.5.0",
    "next": "^15.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "^0.33.4",
    "server-only": "^0.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6",
    "wrangler": "^4.16.1"
  },
  "browserslist": [
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 16",
    "Edge >= 100"
  ],
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  }
}
