{
  "name": "packet-view-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:presets && npm run generate:og-font && next dev",
    "build:presets": "tsx scripts/build-presets.ts",
    "generate:og-font": "tsx scripts/generate-og-font.ts",
    "prebuild": "npm run build:presets && npm run generate:og-font",
    "build": "opennextjs-cloudflare build",
    "build:next": "npm run generate:og-font && next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run build:presets && eslint . --max-warnings 0",
    "pretypecheck": "npm run build:presets && npm run generate:og-font",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:presets",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:format": "vitest run tests/unit/formats",
    "build:worker": "npm run build",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "preview:worker:start": "opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "lz-string": "^1.5.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "satori": "^0.26.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@fontsource/geist": "^5.2.9",
    "@opennextjs/cloudflare": "^1.8.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.1",
    "prettier": "3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6",
    "wrangler": "^4.16.1"
  },
  "browserslist": [
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 16",
    "Edge >= 100"
  ],
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  }
}
