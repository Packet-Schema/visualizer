{
  "yaml.schemas": {
    "./schemas/psdl.schema.json": "data/presets/*.psdl.yaml"
  },
  "eslint.workingDirectories": [
    { "directory": "web", "changeProcessCWD": true }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.associations": {
    "*.psdl.yaml": "yaml"
  }
}
